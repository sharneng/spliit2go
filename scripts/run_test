#!/bin/sh
# One-shot: runs `flutter analyze` + `flutter test --coverage` and logs
# the result to .flutter-ci.log at the repo root. Meant to be called by
# the fswatch loop in SETUP.md, not run standalone (though it's fine to).
#
# Deliberately NOT `set -e`: flutter analyze/test exit non-zero on any
# lint warning or failing test -- that's exactly what we want captured
# in the log, not something that should abort this script early.
set -u

REPO_ROOT="$(git -C "$(dirname "$0")/.." rev-parse --show-toplevel)"
cd "$REPO_ROOT"
LOG="$REPO_ROOT/.flutter-ci.log"

if ! command -v flutter >/dev/null 2>&1; then
  echo "flutter not found on PATH -- run this from a Terminal where 'flutter doctor' works." >&2
  exit 1
fi

cur="$(git rev-parse HEAD 2>/dev/null || echo unknown)"
echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) -- running local CI for $cur..."
(
  echo "=== spliit2go local CI: $(date -u +%Y-%m-%dT%H:%M:%SZ) commit $cur ($(git log -1 --format=%s 2>/dev/null)) ==="
  # app_database.g.dart (and any other *.g.dart) is gitignored -- generated,
  # not committed -- same as CI (.github/workflows/ci.yml). Without this,
  # this script only ever tests whatever .g.dart happened to be sitting on
  # disk from the last manual build_runner run, silently drifting out of
  # sync with the actual table definitions the moment a schema change
  # lands -- exactly the gap that let this go unnoticed until now.
  echo "--- dart run build_runner build ---"
  dart run build_runner build --delete-conflicting-outputs
  build_status=$?
  echo "--- build_runner exit: $build_status ---"
  # flutter gen-l10n (issue #37 phase 1): `flutter analyze` does NOT
  # trigger pubspec.yaml's `flutter.generate: true` localization codegen
  # the way `flutter test`/`flutter run`/`flutter build` do (analyze
  # never goes through flutter_tools' KernelSnapshot build-system
  # target, which is what GenerateLocalizationsTarget hangs off of) --
  # without this, analyze would fail every file that imports
  # lib/l10n/app_localizations.dart with "target of URI doesn't exist"
  # on a checkout where flutter test hasn't already generated it once.
  # Same gap this script's own comment already called out for
  # build_runner/app_database.g.dart, one layer up.
  echo "--- flutter gen-l10n ---"
  flutter gen-l10n
  gen_l10n_status=$?
  echo "--- flutter gen-l10n exit: $gen_l10n_status ---"
  echo "--- flutter analyze ---"
  flutter analyze
  analyze_status=$?
  echo "--- flutter analyze exit: $analyze_status ---"
  echo "--- flutter test --coverage ---"
  flutter test --coverage
  test_status=$?
  echo "--- flutter test exit: $test_status ---"
  if command -v lcov >/dev/null 2>&1 && [ -f coverage/lcov.info ]; then
    echo "--- coverage summary ---"
    lcov --summary coverage/lcov.info
  fi
  echo "=== done: $(date -u +%Y-%m-%dT%H:%M:%SZ) -- build:$build_status gen_l10n:$gen_l10n_status analyze:$analyze_status test:$test_status ==="
) > "$LOG" 2>&1
echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) -- done, see $LOG"
