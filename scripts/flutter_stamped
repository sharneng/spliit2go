#!/bin/sh
# Runs `flutter run` or `flutter build` stamped with the commit it was
# built from (#174): the build number is the commit count, and the
# short hash goes in as GIT_SHA, with "-dirty" when tracked files have
# uncommitted changes. About shows both, e.g. "Version 1.0.0 (249 ·
# a1b2c3d)".
#
#   scripts/flutter_stamped build appbundle --release
#   scripts/flutter_stamped build ipa --release
#   scripts/flutter_stamped run --release -d <device>
#
# `build` passes everything after it to flutter. `flutter run` has no
# --build-number, so `run` builds a stamped APK in the mode given
# (--debug, the default, --profile or --release) and runs it with
# --use-application-binary. That's Android only. Only the mode goes to
# the build; every argument goes to `flutter run`. GIT_SHA goes to the
# run as well, since a debug run syncs the Dart code it compiles.
#
# The count only grows along one line of history, so store uploads
# should be built from main (see SETUP.md, App identity).
set -eu

REPO_ROOT="$(git -C "$(dirname "$0")/.." rev-parse --show-toplevel)"
cd "$REPO_ROOT"

usage() {
  echo "usage: scripts/flutter_stamped build <target> [flutter build args...]" >&2
  echo "       scripts/flutter_stamped run [--debug|--profile|--release] [flutter run args...]" >&2
  exit 2
}

[ $# -gt 0 ] || usage
COMMAND="$1"
shift
case "$COMMAND" in
  run|build) ;;
  *) usage ;;
esac

if [ "$(git rev-parse --is-shallow-repository)" = "true" ]; then
  echo "This is a shallow clone, so the commit count would be wrong; run 'git fetch --unshallow' first." >&2
  exit 1
fi

COUNT="$(git rev-list --count HEAD)"
SHA="$(git rev-parse --short=7 HEAD)"
if ! git diff --quiet HEAD --; then
  SHA="$SHA-dirty"
fi
echo "Build $COUNT, commit $SHA" >&2

if [ "$COMMAND" = build ]; then
  exec flutter build "$@" --build-number="$COUNT" --dart-define=GIT_SHA="$SHA"
fi

MODE=debug
for arg in "$@"; do
  case "$arg" in
    --debug) MODE=debug ;;
    --profile) MODE=profile ;;
    --release) MODE=release ;;
  esac
done

flutter build apk --"$MODE" --build-number="$COUNT" --dart-define=GIT_SHA="$SHA"
APK="build/app/outputs/flutter-apk/app-$MODE.apk"
exec flutter run "$@" --use-application-binary="$APK" --dart-define=GIT_SHA="$SHA"
