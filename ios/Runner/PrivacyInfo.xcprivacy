<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The app's privacy manifest (#108): no tracking, and nothing collected by the
  developer (expenses go to the Spliit server the user picks; see docs/privacy.md).
  The required-reason APIs below are used by bundled code whose own manifest
  doesn't declare them: SQLite (sqlite3 and sqlite3_flutter_libs, which ship
  none) stats its database files and their file system, and package_info_plus
  reads the app bundle's dates. The plugins that declare their own
  (shared_preferences: UserDefaults) are covered by theirs.
-->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<!-- Files inside the app's container: SQLite's database, the app bundle. -->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
			</array>
		</dict>
		<dict>
			<!-- SQLite's statfs/fstatfs on the file system it writes its database to. -->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryDiskSpace</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>E174.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
