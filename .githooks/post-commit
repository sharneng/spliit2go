#!/bin/sh
# Local-only CI: runs `flutter analyze` + `flutter test --coverage` in the
# background after every commit, so `git commit` itself stays fast. Output
# (exit codes + coverage summary) lands in .flutter-ci.log at repo root,
# overwritten each run. Enabled via `git config core.hooksPath .githooks`
# (see SETUP.md) -- this only affects your own local clone.
(
  cd "$(git rev-parse --show-toplevel)" || exit 1
  LOG=".flutter-ci.log"
  {
    echo "=== spliit2go local CI: $(date -u +%Y-%m-%dT%H:%M:%SZ) commit $(git rev-parse HEAD) ($(git log -1 --format=%s)) ==="
    echo "--- flutter analyze ---"
    flutter analyze
    analyze_status=$?
    echo "--- flutter analyze exit: $analyze_status ---"
    echo "--- flutter test --coverage ---"
    flutter test --coverage
    test_status=$?
    echo "--- flutter test exit: $test_status ---"
    if command -v lcov >/dev/null 2>&1 && [ -f coverage/lcov.info ]; then
      echo "--- coverage summary ---"
      lcov --summary coverage/lcov.info
    fi
    echo "=== done: $(date -u +%Y-%m-%dT%H:%M:%SZ) -- analyze:$analyze_status test:$test_status ==="
  } > "$LOG" 2>&1
) &
disown
