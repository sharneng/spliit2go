# Flutter/Dart
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
*.g.dart
*.freezed.dart

# flutter gen-l10n output (issue #37 phase 1) -- generated from
# lib/l10n/app_*.arb the same way app_database.g.dart is generated
# from its own source: not committed, regenerated by `flutter
# analyze`/`flutter test`/`flutter build` themselves once
# pubspec.yaml's flutter.generate is true.
lib/l10n/app_localizations*.dart

# Android
android/.gradle/
android/local.properties
android/**/gradle-wrapper.jar
*.iml

# iOS
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec

# IDE
.idea/
.vscode/
*.iml

# Local config (device-specific Spliit instance URL, etc.)
lib/api/local_config.dart
.flutter-ci.log
coverage/

# Secrets dropped locally for Claude to read via the device bridge -- never commit
.secrets/
